{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "vless-reality",
      "listen": "0.0.0.0",
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "127.0.0.1:8443",
          "xver": 0,
          "serverNames": [
            "proxy.qip.zone"
          ],
          "privateKey": "REPLACE_WITH_PRIVATE_KEY",
          "shortIds": [
            "REPLACE_WITH_SHORT_ID"
          ]
        },
        "xhttpSettings": {
          "path": "/cdn/img",
          "mode": "auto",
          "extra": {
            "xPaddingBytes": "100-1000",
            "scMaxEachPostBytes": "1000000-2000000",
            "scMinPostsIntervalMs": "30-60",
            "xmux": {
              "maxConcurrency": "16-32",
              "hMaxRequestTimes": "600-900",
              "hMaxReusableSecs": "1800-3000"
            }
          }
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "routeOnly": true
      }
    }
  ],
  "outbounds": [
    {
      "tag": "warp",
      "protocol": "wireguard",
      "settings": {
        "secretKey": "REPLACE_WARP_PRIVATE_KEY",
        "address": [
          "172.16.0.2/32"
        ],
        "peers": [
          {
            "publicKey": "bmXOC+F1FxEMF9dyiK2H5/1SUtzH0JuVo51h2wPfgyo=",
            "endpoint": "engage.cloudflareclient.com:2408",
            "keepAlive": 25
          }
        ],
        "mtu": 1280,
        "domainStrategy": "ForceIPv4"
      }
    },
    {
      "tag": "service",
      "protocol": "freedom",
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "ForceIPv4"
        }
      }
    },
    {
      "tag": "to-caddy",
      "protocol": "freedom",
      "settings": {
        "redirect": "127.0.0.1:8443",
        "finalRules": [
          {
            "action": "allow",
            "network": "tcp",
            "port": "8443",
            "ip": [
              "127.0.0.1/32"
            ]
          }
        ]
      }
    },
    {
      "tag": "to-ssh",
      "protocol": "freedom",
      "settings": {
        "redirect": "127.0.0.1:22",
        "finalRules": [
          {
            "action": "allow",
            "network": "tcp",
            "port": "22",
            "ip": [
              "127.0.0.1/32"
            ]
          }
        ]
      }
    },
    {
      "tag": "block",
      "protocol": "blackhole"
    }
  ],
  "routing": {
    "domainStrategy": "IPOnDemand",
    "rules": [
      {
        "type": "field",
        "outboundTag": "to-caddy",
        "domain": [
          "full:progress-bot.qip.zone",
          "full:proxy.qip.zone"
        ],
        "port": "443"
      },
      {
        "type": "field",
        "outboundTag": "block",
        "protocol": [
          "bittorrent"
        ]
      },
      {
        "type": "field",
        "outboundTag": "block",
        "port": "25,465,587"
      },
      {
        "type": "field",
        "outboundTag": "block",
        "ip": [
          "geoip:private"
        ]
      },
      {
        "type": "field",
        "outboundTag": "block",
        "ip": [
          "::/0"
        ]
      },
      {
        "type": "field",
        "outboundTag": "to-ssh",
        "port": "22",
        "ip": [
          "85.198.90.240/32"
        ]
      },
      {
        "type": "field",
        "outboundTag": "to-ssh",
        "port": "22",
        "domain": [
          "full:proxy.qip.zone"
        ]
      },
      {
        "type": "field",
        "outboundTag": "block",
        "ip": [
          "85.198.90.240/32"
        ]
      },
      {
        "type": "field",
        "outboundTag": "service",
        "inboundTag": [
          "dns-in"
        ]
      },
      {
        "type": "field",
        "outboundTag": "service",
        "domain": [
          "full:engage.cloudflareclient.com"
        ]
      },
      {
        "type": "field",
        "outboundTag": "warp",
        "network": "tcp,udp"
      }
    ]
  },
  "dns": {
    "servers": [
      "https://1.1.1.1/dns-query"
    ],
    "queryStrategy": "UseIPv4",
    "tag": "dns-in"
  }
}
