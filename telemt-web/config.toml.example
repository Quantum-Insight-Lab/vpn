[general]
use_middle_proxy = true
log_level = "normal"

[general.modes]
classic = false
secure = true
tls = false

[server]
port = 2443

[general.links]
show = ["web-user"]
public_host = "proxy.qip.zone"
public_port = 443

[server.api]
enabled = true
listen = "127.0.0.1:9091"
whitelist = ["127.0.0.1/32", "::1/128"]
read_only = true

[[server.listeners]]
ip = "127.0.0.1"
port = 2443

[[server.listeners]]
ip = "0.0.0.0"
port = 18080
transport = "web"
proxy_protocol = false
reuse_allow = false
web_client_ip_source = "x_forwarded_for"
web_trusted_proxy_cidrs = ["172.30.0.2/32"]

[web]
enabled = true
carrier = "https"
decoy_fasttrack_mode = "off"

[[web.vhosts]]
host = "proxy.qip.zone"
public_addr = "85.198.90.240:443"

[web.vhosts.decoy]
mode = "static_directory"
directory = "/var/lib/telemt/public"
index = "index.html"

[[web.vhosts.profiles]]
user = "web-user"
secret_mode = "dd"
max_sessions = 64
max_streams = 1024
max_streams_per_session = 64

[access.users]
web-user = "REPLACE_WITH_32_HEX"
