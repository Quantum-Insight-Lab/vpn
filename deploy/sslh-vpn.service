[Unit]
Description=sslh-select multiplexer for VLESS/SOCKS/HTTP on 443
After=network.target docker.service

[Service]
Type=forking
PIDFile=/run/sslh.pid
ExecStartPre=/bin/sh -c '/usr/bin/killall -9 sslh 2>/dev/null || true; /usr/bin/killall -9 sslh-fork 2>/dev/null || true; rm -f /run/sslh.pid'
ExecStart=/usr/sbin/sslh-select -F /etc/sslh.cfg
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
