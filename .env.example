# Публичный IP VPS Selectel (KZ)
VPS_IP=0.0.0.0

# Xray VLESS + Reality
XRAY_PORT=443
REALITY_SNI=www.cloudflare.com
REALITY_PUBLIC_KEY=
REALITY_SHORT_ID=
VLESS_FLOW=xtls-rprx-vision
VLESS_FINGERPRINT=chrome

# SOCKS5 / HTTP на :443 через sslh (Telegram без VLESS)
SOCKS_USER=tg
SOCKS_PASS=

# MTProto (опционально, отдельный compose profile / не в default)
MTPROTO_PORT=8443
MTPROTO_DOMAIN=cloudflare.com
MTPROTO_SECRET=

# Docker images
XRAY_IMAGE=ghcr.io/xtls/xray-core:latest
MTG_IMAGE=nineseconds/mtg:2
