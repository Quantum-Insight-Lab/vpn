# Публичный IP VPS Selectel (KZ). Клиенты подключаются сюда.
# Пользовательский трафик с этого адреса не выходит: выход — WARP.
VPS_IP=85.198.90.240

# Xray VLESS + Reality + XHTTP. SNI — свой домен, сайт на 127.0.0.1:8443.
XRAY_PORT=443
REALITY_SNI=proxy.qip.zone
REALITY_PUBLIC_KEY=
REALITY_SHORT_ID=
VLESS_FLOW=
VLESS_FINGERPRINT=chrome
XHTTP_PATH=/cdn/img
XHTTP_MODE=auto

# Docker images
XRAY_IMAGE=ghcr.io/xtls/xray-core:latest
MTG_IMAGE=nineseconds/mtg:2
